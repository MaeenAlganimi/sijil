{
  "name": "sijil-desktop",
  "productName": "Sijil",
  "version": "1.0.0",
  "description": "Secure desktop wrapper for the Sijil hosted web app",
  "author": {
    "name": "Maeen Alganimi"
  },
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:all": "npm run build:linux && npm run build:windows",
    "build:windows": "electron-builder --win dir --x64 --config.win.signAndEditExecutable=false",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.sijil.desktop",
    "productName": "Sijil",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "artifactName": "Sijil-x86_64.AppImage"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Sijil-Setup-x64.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MaeenAlganimi",
        "repo": "sijil",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
