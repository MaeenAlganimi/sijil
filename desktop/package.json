{
  "name": "sijil-desktop",
  "productName": "Sijil",
  "version": "1.0.0",
  "description": "Secure desktop wrapper for the Sijil hosted web app",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:all": "npm run build:linux && npm run build:windows",
    "build:windows": "electron-builder --win dir --x64 --config.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sijil.desktop",
    "productName": "Sijil",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "artifactName": "Sijil-x86_64.AppImage"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Sijil-Setup-x64.exe",
      "signAndEditExecutable": false
    },
    "artifactName": "Sijil-${platform}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
