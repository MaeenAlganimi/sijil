{
  "appId": "com.qudralabs.sijil",
  "appName": "Sijil",
  "webDir": "www",
  "server": {
    "url": "https://docu-guardian.vercel.app",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": ["docu-guardian.vercel.app"]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#16233F"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#16233F"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#16233F",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#16233F",
      "overlaysWebView": false
    }
  }
}
